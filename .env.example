VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY
# Optional free hCaptcha site key; configure the matching secret in Supabase Auth.
VITE_HCAPTCHA_SITE_KEY=

# Keep false until backend signup settings, privacy notice and external checks are complete.
# This UI switch does not replace disabling signups in the Supabase dashboard.
VITE_PUBLIC_ACCESS_ENABLED=false
